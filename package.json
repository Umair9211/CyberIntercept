{
  "name": "cyberintercept",
  "version": "1.0.0",
  "private": true,
  "description": "CyberIntercept — FastAPI backend + Next.js frontend",
  "scripts": {
    "backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
